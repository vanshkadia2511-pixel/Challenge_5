{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src",
    "api",
    "tests",
    "e2e",
    "vite.config.ts",
    "tailwind.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
